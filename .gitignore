# ============================================================
# .gitignore - OkDriver CCTV Platform
# ============================================================

# ============================
# SECRETS — kabhi bhi commit mat karo!
# ============================
.env
.env.local
.env.production
.env.*
!.env.example

# ============================
# Python
# ============================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
*.so
.venv/
venv/
env/
ENV/

# ============================
# Database files
# ============================
*.db
*.sqlite
*.sqlite3

# ============================
# Node / Frontend
# ============================
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn

# Build output
frontend/dist/
frontend/build/

# ============================
# IDE / Editor
# ============================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================
# Docker
# ============================
.docker/

# ============================
# Logs
# ============================
*.log
logs/
