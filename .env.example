# ==============================================================
# OkDriver CCTV Platform - Environment Variables Template
# Copy this file to .env and configure your local settings
# ==============================================================

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:1234@localhost:5432/okdriver

# JWT Secret Key for RBAC Authentication (Generate a secure random string in production)
JWT_SECRET_KEY=okdriver-super-secret-key-2026-cctv-jwt

# Environment Mode (development / production)
ENVIRONMENT=development
